{
  "info": {
    "name": "Voyage AI Embeddings API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.voyageai.com/v1"
    },
    {
      "key": "voyage_api_key",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Single Text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{voyage_api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/embeddings"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": \"What is DevOps?\",\n  \"model\": \"voyage-3-large\",\n  \"input_type\": \"query\"\n}"
        }
      }
    },
