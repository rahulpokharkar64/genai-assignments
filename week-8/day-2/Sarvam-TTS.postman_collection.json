{
  "info": {
    "name": "Sarvam AI - Text to Speech REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.sarvam.ai"
    },
    {
      "key": "apiKey",
      "value": "YOUR_SARVAM_API_KEY"
    }
  ],
  "item": [
    {
      "name": "English",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "api-subscription-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/text-to-speech",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "text-to-speech"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Welcome to Sarvam AI!\",\n  \"target_language_code\": \"en-IN\",\n  \"speaker\": \"shubh\",\n  \"model\": \"bulbul:v3\",\n  \"pace\": 1.0,\n  \"temperature\": 0.6\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200 OK\",()=>pm.response.to.have.status(200));",
              "let j=pm.response.json();",
              "pm.expect(j).to.have.property(\"request_id\");",
              "pm.expect(j).to.have.property(\"audios\");",
              "pm.collectionVariables.set(\"audioBase64\",j.audios[0]);"
            ]
          }
        }
      ]
    },
